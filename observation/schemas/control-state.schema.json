{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-checkin-fabric-v2/control-state.schema.json",
  "title": "V2 dashboard control state",
  "type": "object",
  "required": ["schemaVersion", "sites", "audit"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sites": {"type": "object", "patternProperties": {"^https:\\/\\/[^\\s\\/]+$": {"type": "object", "required": ["policy", "note", "updatedAt", "source"], "properties": {"policy": {"enum": ["monitor", "review", "pause"]}, "note": {"type": "string", "maxLength": 240}, "updatedAt": {"type": "string", "format": "date-time"}, "source": {"const": "dashboard"}}, "additionalProperties": false}}, "additionalProperties": false},
    "audit": {"type": "array", "maxItems": 200, "items": {"type": "object", "required": ["origin", "policy", "note", "recordedAt", "source"], "properties": {"origin": {"type": "string", "format": "uri"}, "policy": {"enum": ["monitor", "review", "pause"]}, "note": {"type": "string", "maxLength": 240}, "recordedAt": {"type": "string", "format": "date-time"}, "source": {"const": "dashboard"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
