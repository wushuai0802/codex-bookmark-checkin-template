{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-checkin-fabric-v2/pt-status.schema.json",
  "title": "V2 read-only PT check-in status observation",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "mode",
    "sources",
    "counts",
    "executionEnabled",
    "sites"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "mode": {
      "const": "status_observe_only"
    },
    "harvestWindow": { "$ref": "#/$defs/harvestWindow" },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "executionEnabled": {
      "const": false
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    }
  },
  "$defs": {
    "harvestWindow": {
      "type": ["object", "null"],
      "required": ["source", "businessDate", "observedAt", "phase", "referenceAt", "deadlineAt"],
      "properties": {
        "source": { "const": "harvest" },
        "businessDate": { "type": "string", "format": "date" },
        "observedAt": { "type": "string", "format": "date-time" },
        "phase": { "enum": ["scheduled", "running"] },
        "referenceAt": { "type": "string", "format": "date-time" },
        "deadlineAt": { "type": "string", "format": "date-time" },
        "origin": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "sites",
        "inLegacyPlan",
        "externalOnly",
        "fresh",
        "discrepancies",
        "supplementCandidates",
        "status"
      ],
      "properties": {
        "sites": {
          "type": "integer",
          "minimum": 0
        },
        "inLegacyPlan": {
          "type": "integer",
          "minimum": 0
        },
        "externalOnly": {
          "type": "integer",
          "minimum": 0
        },
        "fallbackOnly": { "type": "integer", "minimum": 0 },
        "fresh": {
          "type": "integer",
          "minimum": 0
        },
        "discrepancies": {
          "type": "integer",
          "minimum": 0
        },
        "supplementCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "monitorOnlyUnconfirmed": { "type": "integer", "minimum": 0 },
        "guardedReadNeeded": { "type": "integer", "minimum": 0 },
        "verificationPending": { "type": "integer", "minimum": 0 },
        "externalBlocked": { "type": "integer", "minimum": 0 },
        "notSignedConfirmed": { "type": "integer", "minimum": 0 },
        "status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "authoritative",
        "summary",
        "redacted",
        "statusVerified"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "authoritative": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        },
        "redacted": {
          "const": true
        },
        "statusVerified": {
          "type": "boolean"
        },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "businessDate": { "type": "string", "format": "date" },
        "evidenceScope": { "const": "site_account_day" },
        "statusSignal": { "type": "string", "pattern": "^[a-z0-9_]{1,80}$" },
        "profileBinding": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verification": { "const": "task_disabled" },
        "readSafety": { "const": "reviewed_passive" }
      },
      "additionalProperties": false
    },
    "sourceStatus": {
      "type": "object",
      "required": [
        "source",
        "status",
        "observedAt",
        "fresh",
        "authoritative"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "status": {
          "enum": [
            "signed",
            "already_signed",
            "not_signed",
            "unknown",
            "login_required",
            "unreachable",
            "needs_attention",
            "not_available",
            "failed"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "fresh": {
          "type": "boolean"
        },
        "authoritative": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "effective": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "status",
        "observedAt",
        "fresh",
        "authoritative",
        "evidence"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "status": {
          "enum": [
            "signed",
            "already_signed",
            "not_signed",
            "unknown",
            "login_required",
            "unreachable",
            "needs_attention",
            "not_available",
            "failed"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "fresh": {
          "type": "boolean"
        },
        "authoritative": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "failureCode": { "type": "string", "pattern": "^[a-z0-9_]{1,80}$" },
        "underlyingFailureCode": { "type": "string", "pattern": "^[a-z0-9_]{1,80}$" },
        "submissionAttempted": { "type": "boolean" },
        "retryCause": { "enum": ["upstream_unavailable", "rate_limit", "login_required", "harvest_waiting"] },
        "siteCondition": { "const": "site_maintenance" }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": [
        "siteRef",
        "origin",
        "displayName",
        "accountRef",
        "inLegacyPlan",
        "managedBy",
        "effective",
        "sourceStatuses",
        "discrepancy",
        "supplementCandidate",
        "supplementAction",
        "observations"
      ],
      "properties": {
        "siteRef": {
          "type": "string",
          "pattern": "^pt_[a-f0-9]{16}$"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "accountRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^acct_[a-f0-9]{16}$"
        },
        "inLegacyPlan": {
          "type": "boolean"
        },
        "managedBy": {
          "type": "string",
          "maxLength": 80
        },
        "fallbackEnabled": { "type": "boolean" },
        "harvestManaged": { "type": "boolean" },
        "harvestWaiting": { "$ref": "#/$defs/harvestWindow" },
        "evidenceState": { "enum": ["confirmed", "guarded_read_needed", "not_signed_confirmed", "verification_pending", "harvest_waiting", "monitor_only_unconfirmed", "external_blocked", "unavailable", "disabled", "unconfirmed"] },
        "reconciledFromUnknown": { "type": "boolean" },
        "recovery": {
          "type": "object",
          "required": ["code", "blockedSince", "summary"],
          "properties": {
            "code": { "enum": ["prior_outcome_unknown", "submission_outcome_unknown", "unverified_prior_attempt"] },
            "blockedSince": { "type": "string", "format": "date" },
            "summary": { "type": "string", "maxLength": 240 }
          },
          "additionalProperties": false
        },
        "effective": {
          "$ref": "#/$defs/effective"
        },
        "sourceStatuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceStatus"
          }
        },
        "discrepancy": {
          "type": "boolean"
        },
        "supplementCandidate": {
          "type": "boolean"
        },
        "supplementAction": {
          "enum": [
            "manual_review_only",
            "none"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
